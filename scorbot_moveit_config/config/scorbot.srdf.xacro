<?xml version="1.0"?>
<!--
  Semantic description for one Scorbot arm. The robot name must match the URDF
  (scorbot_description/urdf/scorbot.urdf.xacro), which is "scorbot" for both types.

  Arguments
    prefix  same link/joint prefix as the URDF (empty by default)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scorbot">
  <xacro:arg name="prefix" default=""/>
  <xacro:property name="prefix" value="$(arg prefix)"/>

  <!-- The five actuated joints from the base to the tool frame. -->
  <group name="arm">
    <chain base_link="${prefix}base_link" tip_link="${prefix}tool0"/>
  </group>

  <!-- Named poses. Angles in radians, all inside the URDF limits. -->
  <group_state name="zero" group="arm">
    <joint name="${prefix}base_joint" value="0"/>
    <joint name="${prefix}shoulder_joint" value="0"/>
    <joint name="${prefix}elbow_joint" value="0"/>
    <joint name="${prefix}wrist_pitch_joint" value="0"/>
    <joint name="${prefix}wrist_roll_joint" value="0"/>
  </group_state>

  <!-- Arm raised in a shallow inverted V with the tool level and forward:
       a sensible camera resting pose that keeps the arm off the table. -->
  <group_state name="ready" group="arm">
    <joint name="${prefix}base_joint" value="0"/>
    <joint name="${prefix}shoulder_joint" value="0.5"/>
    <joint name="${prefix}elbow_joint" value="-1.0"/>
    <joint name="${prefix}wrist_pitch_joint" value="0.5"/>
    <joint name="${prefix}wrist_roll_joint" value="0"/>
  </group_state>

  <!-- Arm folded up and back, the closest thing to the Scorbot's own home posture. -->
  <group_state name="folded" group="arm">
    <joint name="${prefix}base_joint" value="0"/>
    <joint name="${prefix}shoulder_joint" value="1.6"/>
    <joint name="${prefix}elbow_joint" value="-2.0"/>
    <joint name="${prefix}wrist_pitch_joint" value="0.4"/>
    <joint name="${prefix}wrist_roll_joint" value="0"/>
  </group_state>

  <!-- No end_effector entry: the camera has no joints of its own, and the chain's tip
       link (tool0) is what MoveIt places the interactive marker on. -->

  <!-- Links that touch by construction (adjacent) and can never collide otherwise. -->
  <disable_collisions link1="${prefix}base_link" link2="${prefix}turret_link" reason="Adjacent"/>
  <disable_collisions link1="${prefix}turret_link" link2="${prefix}upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="${prefix}upper_arm_link" link2="${prefix}forearm_link" reason="Adjacent"/>
  <disable_collisions link1="${prefix}forearm_link" link2="${prefix}wrist_link" reason="Adjacent"/>
  <disable_collisions link1="${prefix}wrist_link" link2="${prefix}flange_link" reason="Adjacent"/>
  <!-- The wrist body sits inside the flange/gripper mesh envelope at every roll angle. -->
  <disable_collisions link1="${prefix}forearm_link" link2="${prefix}flange_link" reason="Default"/>
  <!-- Base and turret overlap the upper arm's shoulder pivot at every shoulder angle. -->
  <disable_collisions link1="${prefix}base_link" link2="${prefix}upper_arm_link" reason="Default"/>
</robot>
