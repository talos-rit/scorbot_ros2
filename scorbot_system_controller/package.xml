<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scorbot_system_controller</name>
  <version>0.1.0</version>
  <description>ros2_control controller exposing the ESP32 Scorbot controller's home, enable, disable and clear-fault operations as services, plus a status topic, through scorbot_hardware's system GPIO interfaces.</description>
  <maintainer email="jdodle001@gmail.com">Jacob Odle</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>scorbot_msgs</depend>
  <depend>scorbot_protocol</depend>
  <depend>std_srvs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <controller_interface plugin="${prefix}/scorbot_system_controller_plugin.xml"/>
  </export>
</package>
