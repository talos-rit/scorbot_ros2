<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scorbot_ros2</name>
  <version>0.1.0</version>
  <description>Meta-package for the Talos-RIT Scorbot ROS 2 stack.</description>
  <maintainer email="jdodle001@gmail.com">Jacob Odle</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>scorbot_description</exec_depend>
  <exec_depend>scorbot_bringup</exec_depend>
  <exec_depend>scorbot_moveit_config</exec_depend>
  <exec_depend>scorbot_kinematics</exec_depend>
  <exec_depend>scorbot_protocol</exec_depend>
  <exec_depend>scorbot_esp_sim</exec_depend>
  <exec_depend>scorbot_msgs</exec_depend>
  <exec_depend>scorbot_hardware</exec_depend>
  <exec_depend>scorbot_system_controller</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
