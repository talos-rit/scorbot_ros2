<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scorbot_protocol</name>
  <version>0.1.0</version>
  <description>Pi-to-ESP32 protocol for the Scorbot controller: protobuf (nanopb) messages, COBS/CRC serial framing, transports, link layer and a bench CLI. No ROS dependencies.</description>
  <maintainer email="jdodle001@gmail.com">Jacob Odle</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
