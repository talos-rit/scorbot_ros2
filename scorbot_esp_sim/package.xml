<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scorbot_esp_sim</name>
  <version>0.1.0</version>
  <description>Simulated ESP32 Scorbot controller speaking scorbot_protocol over a pseudo-terminal: the executable specification of the firmware behaviour and the test double for the hardware interface.</description>
  <maintainer email="jdodle001@gmail.com">Jacob Odle</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>scorbot_protocol</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
